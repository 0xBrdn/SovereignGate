# Domain & TLS (Caddy automatic Let's Encrypt / ZeroSSL)
SOVEREIGNGATE_DOMAIN=audit.sovereigngate.ch
ACME_EMAIL=ops@sovereigngate.ch

# Django Core Security
DEBUG=False
SECRET_KEY=replace-with-64-char-cryptographic-random-string
ALLOWED_HOSTS=audit.sovereigngate.ch

# Sovereign MySQL 8.4 Credentials
MYSQL_DATABASE=sovereigngate_db
MYSQL_USER=sovereigngate_user
MYSQL_PASSWORD=replace-with-strong-db-password
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password

# Internal Docker Network Connection String
DATABASE_URL=mysql://sovereigngate_user:replace-with-strong-db-password@db:3306/sovereigngate_db