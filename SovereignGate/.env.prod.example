# Domain & TLS (Caddy automatic Let's Encrypt / ZeroSSL)
SOVEREIGNGATE_DOMAIN=audit.example.ch
ACME_EMAIL=ops@example.ch

# Django core. SECRET_KEY must be >= 32 random chars; the app refuses to start otherwise.
DEBUG=False
SECRET_KEY=replace-with-64-char-cryptographic-random-string
ALLOWED_HOSTS=audit.example.ch
# The app sits behind Caddy: trust X-Forwarded-Proto / X-Real-IP. Never enable if the app is exposed directly.
TRUST_PROXY_HEADERS=True

# Optional tuning (defaults shown)
# SG_INGEST_RATE_LIMIT=60          # requests per minute per API token
# SG_MAX_FINDINGS_PER_SCAN=5000
# SG_LOGIN_MAX_ATTEMPTS=8
# SESSION_COOKIE_AGE=28800
# LOG_LEVEL=INFO

# MySQL 8.4 credentials
MYSQL_DATABASE=sovereigngate_db
MYSQL_USER=sovereigngate_user
MYSQL_PASSWORD=replace-with-strong-db-password
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password

# Must match the password above
DATABASE_URL=mysql://sovereigngate_user:replace-with-strong-db-password@db:3306/sovereigngate_db
